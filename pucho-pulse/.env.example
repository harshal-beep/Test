# Pucho Pulse — environment (TRD §10)

# Primary (writes only: Workshop, Organization attribution columns, PropensityLog, GtmAlert)
DATABASE_URL=postgres://pulse:pulse@localhost:5432/pulse_fixture
# Read replica — EVERY analytics query. Required in production.
REPLICA_URL=postgres://pulse:pulse@localhost:5432/pulse_fixture

PULSE_BASE_URL=http://localhost:3100
# Grant-account scope: PARTNER_FALLBACK (channelPartnerId IS NOT NULL) until M1
# attribution is live in production, then WORKSHOP.
PULSE_GRANT_SCOPE=WORKSHOP

CREDIT_VALUE_INR=0.30
GRANT_CREDITS=1000

# ── Pucho ↔ Pulse webhooks ────────────────────────────────────────────────
# OUTBOUND: Pulse decides who/when/which template; Pucho does the sending.
# Unset = dry run (logs the exact payload). See src/lib/whatsapp.ts for the
# full contract.
PULSE_OUTBOUND_WEBHOOK_URL=
PULSE_OUTBOUND_WEBHOOK_SECRET=

# INBOUND: Pucho's QR / web-workshop registration POSTs completed
# registrations to /api/webhooks/registration with this secret. Required for
# that endpoint to accept anything. See src/app/api/webhooks/registration.
PULSE_INBOUND_WEBHOOK_SECRET=

# Ops escalation target for SLA breaches.
PULSE_SALES_PHONE=

# Keycloak (RBAC: pulse.admin / pulse.sales / pulse.workshop)
KEYCLOAK_ISSUER=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
